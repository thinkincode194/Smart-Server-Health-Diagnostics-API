# Which provider to use: groq | gemini | openai
LLM_PROVIDER=groq
 
# Your API key (Groq: console.groq.com, Gemini: aistudio.google.com, OpenAI: platform.openai.com)
LLM_API_KEY=your_api_key_here
 
# Model name (must be a model your provider currently offers; providers retire models over time)
LLM_MODEL=openai/gpt-oss-20b
 
# Optional: seconds to wait for the LLM before falling back (default 10)
LLM_TIMEOUT_SECONDS=10
 
# Optional: status thresholds in percent
WARNING_THRESHOLD=70
CRITICAL_THRESHOLD=85
 